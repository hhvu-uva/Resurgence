Cell[TextData[{
 "Substituting the rescalings into (3.2) gives the rescaled ODE. The chain \
rule contributes a factor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\|01d716", 
    RowBox[{"4", 
     RowBox[{"k", "/", "5"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1cc74c03-9275-e349-9c53-0d7300c5cfe3"],
 " to each derivative of order \|01d458."
}], "Text",
 CellChangeTimes->{{3.993292295488306*^9, 3.993292415308895*^9}, {
  3.993736434875635*^9, 3.9937364762863255`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"6e32d0e2-99fc-4342-ad3d-b37be1e7e154"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"derivRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Y", "''''"}], "[", "x1", "]"}], "->", 
       RowBox[{
        RowBox[{"eps", "^", 
         RowBox[{"(", 
          RowBox[{"16", "/", "5"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"psi", "''''"}], "[", "z", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Y", "''"}], "[", "x1", "]"}], "->", 
       RowBox[{
        RowBox[{"eps", "^", 
         RowBox[{"(", 
          RowBox[{"8", "/", "5"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"psi", "''"}], "[", "z", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Y", "'"}], "[", "x1", "]"}], "->", 
       RowBox[{
        RowBox[{"eps", "^", 
         RowBox[{"(", 
          RowBox[{"4", "/", "5"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"psi", "'"}], "[", "z", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Y", "[", "x1", "]"}], "->", 
       RowBox[{"psi", "[", "z", "]"}]}]}], " ", "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rescaledSwallowtailODE", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"swallowtailODE", " ", "/.", " ", "derivRules"}], " ", "/.", 
      "rescaleRules"}], " ", "//", " ", "Simplify"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Equation", " ", 
     RowBox[{"(", 
      RowBox[{"3.5", "a"}], ")"}]}], ",", 
    RowBox[{
    "normalised", " ", "so", " ", "the", " ", "z", " ", "psi", " ", "term", " ",
      "carries", " ", "no", " ", "eps"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rescaledSwallowtailODEObject", "=", " ", 
   RowBox[{
