 FrameBox[
  TemplateBox[{
   "\"\:2705 \"", "\"transportEqnDerived equals paper's (3.10)\"", "\": \"", 
    "True"},
   "RowDefault"],
  Background->RGBColor[0.7, 1., 0.7],
  FrameMargins->5,
  FrameStyle->None,
  RoundingRadius->4,
  StripOnInput->False]], "Output",
