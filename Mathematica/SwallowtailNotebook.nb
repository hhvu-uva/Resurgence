Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Equation", " ", 
     RowBox[{"(", "3.11", ")"}]}], ";", 
    RowBox[{
    "the", " ", "integration", " ", "constant", " ", "is", " ", "fixed", " ", 
     "to", " ", 
     RowBox[{"Sqrt", "[", "Pi", "]"}]}], ";", " ", 
    RowBox[{"NB", ":", " ", 
     RowBox[{
     "There", " ", "is", " ", "a", " ", "sign", " ", "difference", " ", 
      "compared", " ", "to", " ", 
      RowBox[{"(", "3.11", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"psi0", "=", 
    RowBox[{"DSolve", "[", 
     RowBox[{"transportEqn", ",", 
      RowBox[{
       RowBox[{"ampn", "[", "0", "]"}], "[", "z", "]"}], ",", "z"}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.992607931258566*^9, 3.992607941944233*^9}, {
   3.9926079801679554`*^9, 3.9926080097385826`*^9}, {3.992608110323557*^9, 
   3.992608112128134*^9}, {3.992609494689268*^9, 3.9926095203766327`*^9}, {
   3.9926097781787434`*^9, 3.9926098122263985`*^9}, {3.9926098632438984`*^9, 
   3.9926098746728306`*^9}, {3.992609916912634*^9, 3.992609951378086*^9}, {
   3.992609985247284*^9, 3.9926100123756886`*^9}, {3.9926100953965225`*^9, 
   3.9926100997104244`*^9}, {3.9937371817383785`*^9, 
   3.9937372524359818`*^9}, {3.993791631115055*^9, 3.9937916415837593`*^9}, 
   3.994391185410568*^9, {3.994391221621681*^9, 3.9943913362779846`*^9}, {
   3.994391367053282*^9, 3.9943913680814743`*^9}, {3.9943914556940327`*^9, 
   3.9943915302092743`*^9}, {3.9943916351019707`*^9, 3.994391688845337*^9}, {
