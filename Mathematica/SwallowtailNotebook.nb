  RowBox[{
   RowBox[{
    RowBox[{"buildChiGrids", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x0_", ",", "x1_", ",", "nx_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y0_", ",", "y1_", ",", "ny_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xs", ",", "ys", ",", "g"}], "}"}], ",", 
