Cell[CellGroupData[{

Cell["Section 3.1", "Section",
 CellChangeTimes->{{3.9932909750368595`*^9, 3.993290977049343*^9}, {
  3.9932916576079426`*^9, 
  3.9932916634382877`*^9}},ExpressionUUID->"c35e02b4-4e50-9b45-85c7-\
1ddd910b3c7e"],

Cell["\<\
The swallowtail integral is a fundamental integral of catastrophe theory, \
with a quintic phase in the integration variable and three real parameters.\
\>", "Text",
 CellChangeTimes->{3.9932916697759*^9, 3.993291835971237*^9, 
  3.9937359788577824`*^9},
 Background->GrayLevel[
  0.85],ExpressionUUID->"d42b26a9-c735-9a40-885b-cdcb201ff9c7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phaseIntegrandPsi", "[", "t_", "]"}], ":=", 
   RowBox[{"I", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"t", "^", "5"}], " ", "+", " ", 
      RowBox[{"x3", " ", 
       RowBox[{"t", "^", "3"}]}], " ", "+", " ", 
      RowBox[{"x2", " ", 
       RowBox[{"t", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"x1", " ", "t"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"integrandPsi", "[", "t_", "]"}], " ", ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"phaseIntegrandPsi", "[", "t", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Equation", 
    RowBox[{"(", "3.1", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Psi", "[", 
   RowBox[{"x1_", ",", " ", "x2_", ",", " ", "x3_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"integrandPsi", "[", "t", "]"}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.992521459856447*^9, 3.9925216905899944`*^9}, 
   3.9925983411830597`*^9, {3.992599047971798*^9, 3.9925990955592957`*^9}, {
   3.992599128616297*^9, 3.9925991370219917`*^9}, {3.992600930451891*^9, 
   3.9926009605766106`*^9}, {3.9926011234424114`*^9, 3.992601154376297*^9}, {
   3.9926126829755783`*^9, 3.9926126916817017`*^9}, {3.993291217338663*^9, 
   3.9932912240572834`*^9}, {3.993291410415386*^9, 3.9932914175047455`*^9}, {
   3.9932916749985847`*^9, 3.9932917014205856`*^9}, 3.9937359984512386`*^9},
 CellLabel->"In[93]:=",ExpressionUUID->"14995b6f-a1f6-0f4f-a5ed-de92908dcb4d"],

Cell[TextData[{
 "The integral satisfies a fourth-order linear ODE in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\|01d465", "1"], TraditionalForm]],ExpressionUUID->
  "90acf8fa-a829-a944-bb99-f17b8fa35086"],
 " with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "1270833a-996a-0d40-983e-79621b08a20e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "d0d3277f-b9b8-4340-94bf-930d860cb22e"],
 " entering as parameters.\n\t\:200b\nThe unknown is written \|01d44c to keep \
it distinct from the integral above."
}], "Text",
 CellChangeTimes->{
  3.9932917208780136`*^9, 3.9932918332460537`*^9, 3.9937360278752346`*^9, {
   3.9937360579906197`*^9, 3.9937361628042393`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"c4287518-11b0-364e-80cd-8ff034f3e16f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"swallowtailODE", " ", "=", " ", 
    RowBox[{
     RowBox[{"5", " ", 
      RowBox[{
       RowBox[{"Y", "''''"}], "[", "x1", "]"}]}], " ", "-", " ", 
     RowBox[{"3", "x3", " ", 
      RowBox[{
       RowBox[{"Y", "''"}], "[", "x1", "]"}]}], " ", "-", " ", 
     RowBox[{"2", " ", "I", " ", "x2", " ", 
      RowBox[{
       RowBox[{"Y", "'"}], "[", "x1", "]"}]}], " ", "+", " ", 
     RowBox[{"x1", " ", 
      RowBox[{"Y", "[", "x1", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Equation", " ", 
    RowBox[{"(", "3.2", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"swallowtailODEObject", " ", "=", " ", 
  RowBox[{"swallowtailODE", " ", "==", "0"}]}]}], "Input",
 CellChangeTimes->{{3.9925219024537144`*^9, 3.992522059546049*^9}, {
  3.9925221251861095`*^9, 3.992522138546818*^9}, {3.9925221924460144`*^9, 
