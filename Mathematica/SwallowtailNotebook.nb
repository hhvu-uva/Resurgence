Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"All", " ", "12", " ", "higher"}], "-", 
     RowBox[{"order", " ", "Stokes", " ", "triples", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"i", "<", "k"}], ",", 
         RowBox[{"and", " ", "j", " ", "the", " ", "third", " ", "index"}]}], 
        ")"}], ".", "h_"}], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", ">", "k"}], ";", "j"}], "}"}], " ", "and", " ", "h_", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"k", ">", "i"}], ";", "j"}], "}"}], " ", "coincide", " ", 
      "as", " ", "curves"}]}], ",", 
    RowBox[{
     RowBox[{"so", " ", "i"}], "<", 
     RowBox[{"k", " ", 
      RowBox[{"suffices", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hTriples", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "<", "k"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "k", ",", "j"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Complement", "[", 
                RowBox[{
                 RowBox[{"Range", "[", "4", "]"}], ",", 
