Cell[TextData[{
 StyleBox["A far-field rescaling introduces the small parameter \|01d716, so \
that the ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{"large", " ", 
    SubscriptBox["x", "1"]}], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "67487654-527d-bb4f-b67c-06210ad0116a"],
 StyleBox[" asymptotics of \[CapitalPsi] become the small  \|01d716 \
asymptotics of \|01d713. \n\nThe integration variable is rotated by \|01d461 \
\[RightTeeArrow]\[Minus]\|01d456\|01d461, which brings the exponent to the \
standard steepest-descent form.",
  FontColor->GrayLevel[0]],
 StyleBox["\n\nNote that the t rotation includes a eps^(-1/5) factor which is \
not mentioned in the paper.",
  FontColor->RGBColor[0.93, 0.27, 0.27]]
}], "Text",
 CellChangeTimes->{{3.9932915756551704`*^9, 3.993291618914221*^9}, {
  3.993291824825266*^9, 3.9932918485386677`*^9}, {3.9932918857040253`*^9, 
  3.9932918920508003`*^9}, {3.993736213141966*^9, 3.993736343346115*^9}, {
  3.994389675022291*^9, 3.994389712154789*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"13f9054a-a39f-7541-bc2e-09f7c966c5ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rescaleRules", " ", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x1", " ", "->", 
      RowBox[{"z", " ", 
       RowBox[{"eps", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "4"}], "/", "5"}], ")"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"x2", " ", "->", " ", 
      RowBox[{"b", " ", 
       RowBox[{"eps", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "/", "5"}], ")"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"x3", " ", "->", " ", 
      RowBox[{"a", " ", 
       RowBox[{"eps", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "/", "5"}], ")"}]}]}]}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tRotateRule", " ", "=", " ", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"t", "->", " ", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "t", " ", 
       RowBox[{"eps", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "5"}], ")"}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fDerived", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"phaseIntegrandPsi", "[", "t", "]"}], "/.", " ", 
       "rescaleRules"}], "/.", " ", "tRotateRule"}], ")"}], " ", "eps"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", "z_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"t", "^", "5"}], " ", "-", " ", 
    RowBox[{"a", " ", 
     RowBox[{"t", "^", "3"}]}], " ", "-", " ", 
    RowBox[{"I", " ", "b", " ", 
     RowBox[{"t", "^", "2"}]}], " ", "+", " ", 
    RowBox[{"z", " ", "t"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"check", "[", 
  RowBox[{"\"\<fDerived equals paper's f[t,z]\>\"", ",", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"fDerived", " ", "-", " ", 
      RowBox[{"f", "[", 
       RowBox[{"t", ",", "z"}], "]"}]}], "]"}], "==", " ", "0"}]}], " ", 
  "]"}]}], "Input",
