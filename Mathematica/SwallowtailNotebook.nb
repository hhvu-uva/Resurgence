Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Local", " ", "expansion", " ", "f", 
        RowBox[{"(", "t", ")"}]}], "-", " ", 
       RowBox[{"f", 
        RowBox[{"(", "t_i", ")"}]}]}], "\[Tilde]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], " ", 
       RowBox[{"f", "''"}], 
       RowBox[{"(", "t_i", ")"}], " ", 
       RowBox[{"delta", "^", "2."}], " ", "Writing", " ", 
       RowBox[{"f", "''"}], 
       RowBox[{"(", "t_i", ")"}]}]}], "=", 
     RowBox[{
      RowBox[{"R", " ", 
       RowBox[{"e", "^", 
        RowBox[{"{", 
         RowBox[{"I", " ", "phi"}], "}"}]}], " ", "and", " ", "delta"}], "=", 
      RowBox[{"r", " ", 
       RowBox[{"e", "^", 
        RowBox[{"{", 
         RowBox[{"I", " ", "theta"}], "}"}]}]}]}]}], ",", 
    RowBox[{"descent", " ", "requires", " ", 
     RowBox[{"f", "''"}], 
     RowBox[{"(", "t_i", ")"}], " ", 
     RowBox[{"delta", "^", "2"}], " ", "real", " ", "and", " ", "negative"}], 
    ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"i", ".", "e", ".", "2"}], " ", "theta"}], "+", "phi"}], "=", 
     RowBox[{
      RowBox[{"pi", ".", "The"}], " ", "two", " ", "solutions", " ", "are", " ",
       "the", " ", "two", " ", "descent", " ", "arms", " ", "of", " ", "the", 
      " ", 
      RowBox[{"saddle", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"descentDirections", "[", "ti_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"phi", "=", 
         RowBox[{"Arg", "[", 
          RowBox[{"fTpp", "[", "ti", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Pi", "-", "phi"}], ")"}], "/", "2"}]}], "]"}], ",", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Pi", "-", "phi"}], ")"}], "/", "2"}], "+", "Pi"}], 
            ")"}]}], "]"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Steepest", "-", 
      RowBox[{
      "descent", " ", "path", " ", "as", " ", "the", " ", "gradient", " ", 
       "flow", " ", "of", " ", 
       RowBox[{"Re", "[", "f", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"dt", "/", "ds"}], "=", 
       RowBox[{
        RowBox[{"-", "conj"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"f", "'"}], 
           RowBox[{"(", "t", ")"}]}], ")"}], ".", "The"}], " ", "flow", " ", 
        "is", " ", "normalised", " ", "to", " ", "unit", " ", "speed", " ", 
        "so", " ", "it", " ", "does", " ", "not", " ", "stall", " ", "where", 
        " ", 
        RowBox[{"f", "'"}], " ", "is", " ", "small"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "this", " ", "changes", " ", "the", " ", "parametrisation", " ", "but", 
       " ", "not", " ", "the", " ", 
       RowBox[{"curve", ".", "\[IndentingNewLine]", "Integration"}], " ", 
       "starts", " ", "a", " ", "short", " ", "step", " ", "off", " ", "the", 
       " ", "saddle", " ", "along", " ", "a", " ", "descent", " ", 
       "direction"}]}], ",", 
     RowBox[{
     "and", " ", "stops", " ", "on", " ", "reaching", " ", "a", " ", 
      "neighbouring", " ", "saddle"}], ",", 
     RowBox[{"where", " ", 
      RowBox[{"f", "'"}], " ", 
      RowBox[{"vanishes", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"descentRay", "[", 
      RowBox[{"ti_", ",", "dir_", ",", 
       RowBox[{"sMax_", ":", "8"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eps", "=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "2"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"t", "'"}], "[", "s", "]"}], "==", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Conjugate", "[", 
                RowBox[{"fTp", "[", 
                 RowBox[{"t", "[", "s", "]"}], "]"}], "]"}]}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"fTp", "[", 
                  RowBox[{"t", "[", "s", "]"}], "]"}], "]"}], "+", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "6"}]}]}], ")"}]}]}], ",", 
            RowBox[{
             RowBox[{"t", "[", "0", "]"}], "==", 
             RowBox[{"ti", "+", 
              RowBox[{"eps", " ", "dir"}]}]}], ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"fTp", "[", 
                 RowBox[{"t", "[", "s", "]"}], "]"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "3"}]}]}], ",", "\"\<StopIntegration\>\""}], 
             "]"}]}], "}"}], ",", "t", ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "0", ",", "sMax"}], "}"}], ",", 
          RowBox[{"MaxSteps", "->", 
           RowBox[{"10", "^", "5"}]}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Sample", " ", "a", " ", "solution", " ", "over", " ", "its", " ", "own", 
     " ", "integration", " ", "range", " ", "and", " ", "return", " ", "it", " ",
      "as", " ", "a", " ", "curve"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rayLine", "[", "sol_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tf", ",", "sMin", ",", "sMax"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tf", "=", 
         RowBox[{"t", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sMin", ",", "sMax"}], "}"}], "=", 
         RowBox[{
          RowBox[{"tf", "[", "\"\<Domain\>\"", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Line", "[", 
         RowBox[{"ReIm", "/@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"tf", "[", "s", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "sMin", ",", "sMax", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"sMax", "-", "sMin"}], ")"}], "/", "400"}]}], "}"}]}],
            "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Two", " ", "descent", " ", "arms", " ", "from", " ", "each", " ", "of", " ",
      "the", " ", "four", " ", "saddles"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allRays", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ti", "=", 
             RowBox[{"saddles", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"descentRay", "[", 
              RowBox[{"ti", ",", "#"}], "]"}], "&"}], "/@", 
            RowBox[{"descentDirections", "[", "ti", "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "saddles", "]"}]}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Figure", " ", "2", 
       RowBox[{"(", "a", ")"}]}], ":", 
      RowBox[{"arg", "[", "eps", "]"}]}], "=", "0"}], "*)"}], "\n", 
   RowBox[{"figure2a", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"Thickness", "[", "0.004", "]"}], ",", 
        RowBox[{"rayLine", "/@", "allRays"}], ",", "Red", ",", 
        RowBox[{"PointSize", "[", "0.015", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"ReIm", "/@", "saddles"}], "]"}], ",", "Black", ",", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"paperIndex", "[", "#2", "]"}], ",", 
             RowBox[{"ReIm", "[", "#1", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "2."}], ",", "1.5"}], "}"}]}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"saddles", ",", 
            RowBox[{"Range", "[", "4", "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Re[t]\>\"", ",", "\"\<Im[t]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"AspectRatio", "->", 
       RowBox[{"1", "/", "2"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Figure 2(a): steepest-descent contours, z = 3 + 0.5 \
I\>\""}]}], "]"}]}]}]}]], "Input",
