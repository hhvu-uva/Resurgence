Cell[CellGroupData[{

Cell["Section 3.3 \[LongDash] The singulant functions", "Section",
 CellChangeTimes->{{3.99373760401482*^9, 
  3.993737609000778*^9}},ExpressionUUID->"2b2f86f2-a926-fd4b-b312-\
8f716120d5e0"],

Cell[TextData[{
 "The singulant follows from the saddle-point exponent. The saddles satisfy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "t"], TraditionalForm]],ExpressionUUID->
  "0cceaa57-b1e3-9b4f-968e-4935a671a090"],
 "\|01d453 = 0, and since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "z"], TraditionalForm]],ExpressionUUID->
  "d8095e78-aec5-0c4b-a879-cfbc6fcfd326"],
 "\|01d453 = \|01d461 the chain rule gives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\|01d461", "i"], TraditionalForm]],ExpressionUUID->
  "9ee8a373-34c0-9849-a49f-23ac796d4334"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Minus]", 
    RowBox[{
     SubscriptBox["\|01d712", "i"], "'"}]}], TraditionalForm]],ExpressionUUID->
  "04ea7f71-956d-2644-b5ec-2979e789f778"],
 ". Reduction of \[Minus]\|01d453(\[Minus]",
 Cell[BoxData[
  FormBox[
   RowBox[{"\|01d712", "'"}], TraditionalForm]],ExpressionUUID->
  "ac60669f-89fb-9a4b-a97c-31c6d71145dc"],
 ", \|01d467) modulo the singulant equation yields the closed form."
}], "Text",
 CellChangeTimes->{{3.9937376713451576`*^9, 3.99373781063085*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"c4492b70-7af7-4845-9d4e-4b0b1c57d785"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Equation", " ", 
     RowBox[{"(", 
      RowBox[{"3.16", "a"}], ")"}]}], ",", 
    RowBox[{"integral", " ", "route"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"chiRouteA", " ", "=", " ", 
    RowBox[{
     RowBox[{"PolynomialReduce", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"f", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"chi", "'"}], "[", "z", "]"}]}], ",", "z"}], "]"}]}], ",", 
       RowBox[{"First", "[", "singulantEqn", "]"}], ",", 
       RowBox[{
        RowBox[{"chi", "'"}], "[", "z", "]"}]}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.993182563416918*^9, 3.993182607616514*^9}, {
   3.993184360011284*^9, 3.993184361813919*^9}, {3.9935622049410744`*^9, 
   3.9935622132531967`*^9}, {3.9935622697740765`*^9, 3.993562274629982*^9}, {
   3.9935623772343063`*^9, 3.993562398373726*^9}, {3.993562440972904*^9, 
   3.993562465353895*^9}, {3.9935625419565086`*^9, 3.993562571719227*^9}, 
   3.993735303898777*^9, 3.9937378306418858`*^9},
 CellLabel->
  "In[141]:=",ExpressionUUID->"801936d2-02bb-9841-b4e2-14caca1b46db"],

Cell[TextData[{
 "The same result follows from the Hamilton\[Dash]Jacobi system associated \
with the Borel operator. The symbol contains no \|01d464, so \n\|01d702 is \
conserved and, with \|01d702(0) = 1, equals unity; \|01d709 is then linear in \
\|01d70f. Integrating the remaining two equations gives \|01d467(\|01d70f) \
and \|01d464(\|01d70f), and \|01d467(\|01d70f) is recognised as the singulant \
quartic, identifying \|01d70f = \|01d712",
 Cell[BoxData[
  FormBox["'", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b2d17bf-74f6-6542-82ce-4360adcd52a1"],
 " and \|01d464 = \|01d712."
}], "Text",
 CellChangeTimes->{{3.9937378435020847`*^9, 3.9937379997964993`*^9}, {
  3.9937921670504417`*^9, 3.9937921825093155`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"a77b0c7f-5125-8f4a-af5c-26033995a927"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Equation", " ", 
    RowBox[{"(", "3.13", ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"borelSymbol", "=", 
     RowBox[{
      RowBox[{"5", " ", 
       RowBox[{"xi", "^", "4"}]}], "-", 
      RowBox[{"3", " ", "a", " ", 
       RowBox[{"eta", "^", "2"}], " ", 
       RowBox[{"xi", "^", "2"}]}], "-", 
      RowBox[{"2", " ", "I", " ", "b", " ", 
       RowBox[{"eta", "^", "3"}], " ", "xi"}], "+", 
      RowBox[{"z", " ", 
       RowBox[{"eta", "^", "4"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Equation", " ", 
     RowBox[{"(", 
      RowBox[{"3.14", "a"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zPrime", "=", 
     RowBox[{"D", "[", 
      RowBox[{"borelSymbol", ",", "xi"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wPrime", "=", 
     RowBox[{"D", "[", 
      RowBox[{"borelSymbol", ",", "eta"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xiPrime", "=", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{"borelSymbol", ",", "z"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"etaPrime", "=", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{"borelSymbol", ",", "w"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"etaAndXiRule", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eta", "->", "1"}], ",", 
       RowBox[{"xi", "->", 
        RowBox[{"-", "tau"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"zPrimeReduced", "=", 
     RowBox[{"zPrime", "/.", " ", "etaAndXiRule"}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wPrimeReduced", "=", 
     RowBox[{"wPrime", "/.", " ", "etaAndXiRule"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Equation", " ", 
     RowBox[{"(", 
      RowBox[{"3.15", "a"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solZ", "=", 
     RowBox[{
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Z", "'"}], "[", "tau", "]"}], "==", "zPrimeReduced"}], ",", 
          RowBox[{
           RowBox[{"Z", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
        RowBox[{"Z", "[", "tau", "]"}], ",", "tau"}], "]"}], "//", 
      "First"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"zOfTau", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Z", "[", "tau", "]"}], "/.", " ", "solZ"}], "//", 
      "Expand"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Equation", " ", 
       RowBox[{"(", 
        RowBox[{"3.15", "b"}], ")"}]}], ";", 
      RowBox[{
       RowBox[{"w", "'"}], " ", "depends", " ", "on", " ", "z"}]}], ",", 
     RowBox[{
     "which", " ", "evolves", " ", "along", " ", "the", " ", 
      "characteristic"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wPrimeReducedInTau", "=", 
     RowBox[{
      RowBox[{"wPrimeReduced", "/.", " ", 
       RowBox[{"z", "->", "zOfTau"}]}], "//", "Expand"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solW", "=", 
     RowBox[{
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"W", "'"}], "[", "tau", "]"}], "==", 
           "wPrimeReducedInTau"}], ",", 
          RowBox[{
           RowBox[{"W", "[", "0", "]"}], "==", "w0"}]}], "}"}], ",", 
        RowBox[{"W", "[", "tau", "]"}], ",", "tau"}], "]"}], "//", 
      "First"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wOfTau", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"W", "[", "tau", "]"}], "/.", " ", "solW"}], "//", 
      "Expand"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tauConstraint", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{"z", "-", "zOfTau"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Equation", " ", 
      RowBox[{"(", 
       RowBox[{"3.16", "a"}], ")"}]}], ",", 
     RowBox[{"Hamilton", "-", 
      RowBox[{"Jacobi", " ", "route"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chiRouteB", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"PolynomialReduce", "[", 
        RowBox[{"wOfTau", ",", "tauConstraint", ",", "tau"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], "//", "Expand"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chiFunction", "[", "z", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", "a"}], "5"]}], 
      RowBox[{
       RowBox[{
        RowBox[{"chi", "'"}], "[", "z", "]"}], "^", "3"}]}], " ", "+", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"3", "I", " ", "b"}], "5"], 
      RowBox[{
       RowBox[{
        RowBox[{"chi", "'"}], "[", "z", "]"}], "^", "2"}]}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"4", "z"}], "5"], 
      RowBox[{
       RowBox[{"chi", "'"}], "[", "z", "]"}]}], "+", "w0"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"check", "[", 
    RowBox[{"\"\<Routes A (integral) and B (Hamilton-Jacobi) give the same \!\
\(\*SubscriptBox[\(\[Chi]\), \(i\)]\)[z]\>\"", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"chiRouteB", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tau", "->", 
           RowBox[{
            RowBox[{"chi", "'"}], "[", "z", "]"}]}], ",", 
          RowBox[{"w0", "->", "0"}]}], "}"}]}], ")"}], "==", "chiRouteA"}]}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{"check", "[", 
    RowBox[{"\"\<Derived \!\(\*SubscriptBox[\(\[Chi]\), \(i\)]\)[z] equals \
(3.16a)\>\"", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"chiRouteB", " ", "/.", " ", 
        RowBox[{"tau", "->", 
         RowBox[{
          RowBox[{"chi", "'"}], "[", "z", "]"}]}]}], ")"}], "==", " ", 
      RowBox[{"chiFunction", "[", "z", "]"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9931826774160614`*^9, 3.993182706008768*^9}, {
   3.993183302078657*^9, 3.993183369105728*^9}, {3.993183452229761*^9, 
   3.9931835493149643`*^9}, {3.9931837551097336`*^9, 3.993183802013111*^9}, {
