Cell["\<\
Two roots of the cubic coincide when its discriminant vanishes, giving the \
curved branches of Figure 1. The line \|01d44f = 0 is a separate locus, on \
which two distinct roots map to the same \|01d467.\
\>", "Text",
 CellChangeTimes->{{3.993737508434061*^9, 3.9937375219342327`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"23eaa60d-08ef-2147-8251-fdea38a79375"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"singularCubicDiscriminant", "=", 
   RowBox[{"Discriminant", "[", 
    RowBox[{
     RowBox[{"First", "[", "singularCubic", "]"}], ",", "t"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coalescenceCurves", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"singularCubicDiscriminant", "==", "0"}], ",", "b"}], "]"}], "//",
     "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"branchExprs", "=", 
    RowBox[{"b", "/.", " ", "coalescenceCurves"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Figure", " ", "1"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"figure1", "=", 
  RowBox[{"Plot", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Append", "[", 
      RowBox[{"branchExprs", ",", "0"}], "]"}], "]"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"the", " ", "two", " ", "branches", " ", "plus", " ", "b"}], "=",
       "0"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"a", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", "Red", ",", 
       RowBox[{"Darker", "[", "Green", "]"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "->", 
     RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<a\>\"", ",", "\"\<b\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
    "PlotLabel", 
     "->", "\"\<Figure 1: coalescence curves of the singular points\>\""}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<b = +Sqrt[-2a^3/5]\>\"", 
         ",", "\"\<b = -Sqrt[-2a^3/5]\>\"", ",", "\"\<b = 0\>\""}], "}"}], ",",
        "Right"}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Exclusions", "->", "None"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9926844207248363`*^9, 3.992684476254076*^9}, {
   3.992686041803665*^9, 3.9926860429310894`*^9}, {3.9928614633646355`*^9, 
