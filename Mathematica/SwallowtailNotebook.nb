Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"derivRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Y", "''''"}], "[", "x1", "]"}], "->", 
       RowBox[{
        RowBox[{"eps", "^", 
         RowBox[{"(", 
          RowBox[{"16", "/", "5"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"psi", "''''"}], "[", "z", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Y", "''"}], "[", "x1", "]"}], "->", 
       RowBox[{
        RowBox[{"eps", "^", 
         RowBox[{"(", 
          RowBox[{"8", "/", "5"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"psi", "''"}], "[", "z", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Y", "'"}], "[", "x1", "]"}], "->", 
       RowBox[{
        RowBox[{"eps", "^", 
         RowBox[{"(", 
          RowBox[{"4", "/", "5"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"psi", "'"}], "[", "z", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Y", "[", "x1", "]"}], "->", 
       RowBox[{"psi", "[", "z", "]"}]}]}], " ", "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rescaledSwallowtailODE", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"swallowtailODE", " ", "/.", " ", "derivRules"}], " ", "/.", 
      "rescaleRules"}], " ", "//", " ", "Simplify"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Equation", " ", 
     RowBox[{"(", 
      RowBox[{"3.5", "a"}], ")"}]}], ",", 
    RowBox[{
    "normalised", " ", "so", " ", "the", " ", "z", " ", "psi", " ", "term", " ",
      "carries", " ", "no", " ", "eps"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rescaledSwallowtailODEObject", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"eps", "^", 
      RowBox[{"(", 
       RowBox[{"4", "/", "5"}], ")"}]}], " ", "rescaledSwallowtailODE"}], "==",
     "0"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992523755688963*^9, 3.9925238568410378`*^9}, {
   3.9925239543649216`*^9, 3.992523954917694*^9}, {3.9925240309708176`*^9, 
   3.99252409502182*^9}, {3.9925241255574913`*^9, 3.992524196554779*^9}, {
   3.9925242621623936`*^9, 3.9925242687589817`*^9}, {3.9925244716581936`*^9, 
   3.9925244728897076`*^9}, {3.99252450587718*^9, 3.9925245681280823`*^9}, {
   3.9925246153882923`*^9, 3.9925247984381084`*^9}, {3.9925248528316727`*^9, 
   3.9925248551573277`*^9}, {3.9932924858427315`*^9, 3.993292545233612*^9}, {
   3.993292633931898*^9, 3.993292674221428*^9}, {3.99329273906966*^9, 
   3.9932927843279076`*^9}, 3.9937353327213783`*^9, {3.9937365038891525`*^9, 
   3.9937365069609222`*^9}, {3.993736895417473*^9, 3.9937368967969303`*^9}, {
   3.994390528861679*^9, 3.994390531618601*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"7508b119-bbd8-0342-ae3c-d57ecf31a7f3"],

Cell["\<\
The far-field condition selects the integral solution: as \[Divides]z\
\[Divides] \[RightArrow] \[Infinity]  along arg z = \[Minus]3\[Pi]/4, only \
one of the four WKBJ components is present.\
\>", "Text",
 CellChangeTimes->{{3.9937369171059303`*^9, 3.993736940706793*^9}, {
  3.994390540177639*^9, 3.994390552145973*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"0c9eed55-391c-564e-bc64-7554680bae2b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"alpha", " ", "=", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"3", " ", "I", " ", 
      RowBox[{"Pi", "/", "4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equation", " ", 
    RowBox[{"(", 
     RowBox[{"3.5", "b"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psiFarField", "[", "z_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"Sqrt", "[", "Pi", "]"}]}], ")"}], " ", "/", " ", 
     RowBox[{"(", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "*", " ", 
        RowBox[{"5", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "4"}], ")"}]}], " ", "*", " ", 
        RowBox[{"alpha", "^", "3"}], " ", "*", " ", 
        RowBox[{"z", "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "4"}], ")"}]}]}], "]"}], ")"}]}], " ", "*", " ", 
    RowBox[{"Exp", "[", " ", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"4", " ", "alpha", " ", 
        RowBox[{
         RowBox[{"z", "^", 
          RowBox[{"(", 
           RowBox[{"5", "/", "4"}], ")"}]}], " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"5", "^", 
            RowBox[{"(", 
             RowBox[{"5", "/", "4"}], ")"}]}], " ", "eps"}], ")"}]}]}], 
       ")"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9925251580165443`*^9, 3.9925252554675198`*^9}, {
  3.9925252973595543`*^9, 3.9925253590269604`*^9}, {3.9926014965064106`*^9, 
  3.992601496914385*^9}, {3.993736954856781*^9, 3.9937369609605865`*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"25bbe469-755f-0249-bf63-b1d9aa799c42"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Section 3.2 \[LongDash] The asymptotic transseries", "Section",
 CellChangeTimes->{
  3.9937369740766506`*^9},ExpressionUUID->"c9c14d95-bbf7-554e-9b4e-\
7f3f58c88d51"],

Cell["\<\
The transseries consists of four WKBJ components, each an amplitude \
multiplying an exponential of a singulant. Since the ODE is linear and the \
exponentials are independent, the equations for the singulant and amplitude \
follow from substituting a single generic component.\
\>", "Text",
 CellChangeTimes->{3.9937369828835583`*^9},
 Background->GrayLevel[
  0.85],ExpressionUUID->"c5626ee9-8b69-6e46-a5e3-7ddc5a4eb497"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Equation", " ", 
    RowBox[{"(", "3.6", ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"wkbjComponent", "[", "i_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"amp", "[", "i", "]"}], "[", "z", "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"chi", "[", "i", "]"}], "[", "z", "]"}]}], "/", "eps"}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"transseries", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"wkbjComponent", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"singleComponent", "[", "z_", "]"}], ":=", 
     RowBox[{
      RowBox[{"amp", "[", "z", "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"chi", "[", "z", "]"}]}], "/", "eps"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"psiToSingleComponentRule", " ", "=", " ", 
     RowBox[{"psi", " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{"zz", ",", " ", 
        RowBox[{"singleComponent", "[", "zz", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"odePsiToSingleComponentRule", " ", "=", " ", 
     RowBox[{
     "rescaledSwallowtailODE", " ", "/.", " ", "psiToSingleComponentRule"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rescaledSwallowtailODESingleComponent", "=", 
     RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"odePsiToSingleComponentRule", "/", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"chi", "[", "z", "]"}]}], "/", "eps"}], "]"}]}], " ", "*", 
       " ", 
       RowBox[{"eps", "^", 
        RowBox[{"(", 
         RowBox[{"4", "/", "5"}], ")"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.992601457074892*^9, 3.992601458183634*^9}, {
   3.992601511129423*^9, 3.992601622916586*^9}, {3.992601664376152*^9, 
   3.992601692272709*^9}, {3.9937370047484703`*^9, 3.993737022621258*^9}, 
   3.9937370679278927`*^9},
 CellLabel->
  "In[110]:=",ExpressionUUID->"e2e76e36-ee57-194e-a5ef-0f22619cde82"],

Cell[TextData[{
 "Balancing powers of \[Epsilon] gives the singulant equation at leading \
order, a quartic for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "'"}], TraditionalForm]],ExpressionUUID->
  "ff65ef12-450a-f349-89fc-1572f8a7d3d4"],
 "."
}], "Text",
 CellChangeTimes->{{3.993737078999834*^9, 3.9937371090643864`*^9}, {
  3.9943907253685665`*^9, 3.9943907278423977`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"e5cad6b5-c335-944f-ac5c-821a492d34d8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"leadingOrder", "=", 
    RowBox[{"Coefficient", "[", "\[IndentingNewLine]", 
     RowBox[{
     "rescaledSwallowtailODESingleComponent", " ", "\[IndentingNewLine]", ",",
       "eps", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"singulantEqnDerived", " ", "=", " ", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"leadingOrder", "/", " ", 
       RowBox[{"amp", "[", "z", "]"}]}], "]"}], " ", "==", " ", "0"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Corrected", " ", "Equation", " ", 
     RowBox[{"(", "3.7", ")"}]}], ",", " ", 
    RowBox[{"NB", ":", " ", 
     RowBox[{
     "Prefactor", " ", "of", " ", "5", " ", "is", " ", "missing", " ", "in", " ",
       "front", " ", "of", " ", "quartic", " ", "term", " ", "in", " ", 
      RowBox[{"(", "3.7", ")"}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"singulantEqn", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"5", 
       RowBox[{
        RowBox[{
         RowBox[{"chi", "'"}], "[", "z", "]"}], "^", "4"}]}], " ", "-", " ", 
      RowBox[{"3", "a", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"chi", "'"}], "[", "z", "]"}], "^", "2"}]}], " ", "+", " ", 
      RowBox[{"2", " ", "I", " ", "b", " ", 
       RowBox[{
        RowBox[{"chi", "'"}], "[", "z", "]"}]}], " ", "+", " ", "z"}], " ", "==",
      "0"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"check", "[", 
  RowBox[{"\"\<singulantEqnDerived equals (corrected)paper's equation (3.7)\>\
\"", ",", " ", 
   RowBox[{"singulantEqnDerived", " ", "==", " ", "singulantEqn"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.992606459966425*^9, 3.9926064610988617`*^9}, {
   3.992606507814947*^9, 3.992606511684471*^9}, {3.992607099025337*^9, 
   3.992607313490423*^9}, {3.9926073639367485`*^9, 3.992607365439724*^9}, {
   3.992607944883583*^9, 3.9926079777639885`*^9}, {3.993561606226494*^9, 
   3.9935616205135536`*^9}, 3.993735326913164*^9, {3.9937371219938335`*^9, 
   3.9937371414155407`*^9}, 3.994390603499983*^9, {3.994390731645714*^9, 
   3.9943911726665897`*^9}, {3.9943927902116833`*^9, 3.994392798241293*^9}, 
   3.9943943841096916`*^9},
 CellLabel->
  "In[116]:=",ExpressionUUID->"8b5c22e4-85d3-d24b-b0a1-2f2d0a76da6d"],

Cell[BoxData[
 FrameBox[
  TemplateBox[{
   "\"\:2705 \"", 
    "\"singulantEqnDerived equals (corrected)paper's equation (3.7)\"", 
    "\": \"", "True"},
   "RowDefault"],
  Background->RGBColor[0.7, 1., 0.7],
  FrameMargins->5,
  FrameStyle->None,
  RoundingRadius->4,
  StripOnInput->False]], "Output",
 CellChangeTimes->{{3.994391132754532*^9, 3.994391152376972*^9}, {
   3.994392286675846*^9, 3.9943922960392094`*^9}, {3.9943927652280903`*^9, 
   3.9943927989448967`*^9}, 3.9943944979203663`*^9, 3.9943945375186615`*^9},
 CellLabel->
