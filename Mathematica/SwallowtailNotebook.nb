 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"panelClean", "[", "i0_", "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"Round", "[", "i0", "]"}]}], ",", "js", ",", 
        "curveGraphics"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"js", "=", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"Range", "[", "4", "]"}], ",", "i"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"curveGraphics", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"saddleColor", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"Thickness", "[", "0.005", "]"}], ",", 
            RowBox[{"rayLine", "/@", 
             RowBox[{"raysForCj", "[", 
              RowBox[{"j", ",", 
               RowBox[{"sigmaArg", "[", 
                RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "js"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"curveGraphics", ",", "Black", ",", "Thick", ",", 
           RowBox[{"Circle", "[", 
            RowBox[{
             RowBox[{"ReIm", "[", 
              RowBox[{"saddles", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "0.22"}], "]"}], ",",
            "Black", ",", 
           RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
           RowBox[{"Point", "[", 
            RowBox[{"ReIm", "/@", "saddles"}], "]"}], ",", "Black", ",", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Text", "[", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"#2", ",", "Bold"}], "]"}], ",", 
                RowBox[{"ReIm", "[", "#1", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1.6"}], ",", 
                  RowBox[{"-", "1.6"}]}], "}"}]}], "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"saddles", ",", 
               RowBox[{"Range", "[", "4", "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Re[t]\>\"", ",", "\"\<Im[t]\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<(\>\"", ",", 
             RowBox[{"FromCharacterCode", "[", 
              RowBox[{"97", "+", "i"}], "]"}], ",", "\"\<) saddle \>\"", ",", 
             "i"}], "}"}], "\[IndentingNewLine]", "]"}]}]}], 
        "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
