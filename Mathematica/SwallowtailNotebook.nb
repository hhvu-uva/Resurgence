 CellLabel->"Out[45]=",ExpressionUUID->"4b312725-762a-4f4c-9e13-76a95a2b781f"]
}, Open  ]],

Cell[TextData[{
 "For particular values of \|01d44e and \|01d44f the singular points \
coalesce. When \|01d44e = \|01d44f = 0 all three lie at the origin; when \
\|01d44f = 0 two coincide at \|01d467 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"9", 
    SuperscriptBox["\|01d44e", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc56a693-7bc0-da4d-a3c3-20a697225835"],
 "/20."
}], "Text",
 CellChangeTimes->{{3.9937374132961807`*^9, 3.9937374877144833`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"93252727-422e-9645-bf34-d32b2353bc53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Case", " ", "a"}], " ", "=", " ", 
    RowBox[{"b", " ", "=", " ", "0"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", "0"}], ",", 
       RowBox[{"b", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"derived", ",", " ", "expected"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"derived", " ", "=", " ", 
         RowBox[{"zOfTFunction", "/@", 
          RowBox[{"(", 
           RowBox[{"t", "/.", " ", 
            RowBox[{"Solve", "[", 
             RowBox[{"singularCubic", ",", "t"}], "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"expected", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", "0"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"check", "[", 
         RowBox[{"\"\<Derived z values for a = b = 0 equals paper's\>\"", ",",
           " ", 
          RowBox[{"derived", " ", "==", " ", "expected"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Case", " ", "b"}], " ", "=", " ", "0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", "=", "0"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"derived", ",", " ", "expected"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"derived", " ", "=", " ", 
         RowBox[{"zOfTFunction", "/@", 
          RowBox[{"(", 
           RowBox[{"t", "/.", 
            RowBox[{"Solve", "[", 
             RowBox[{"singularCubic", ",", "t"}], "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"expected", " ", "=", " ", 
         RowBox[{"{", " ", 
          RowBox[{
           FractionBox[
            RowBox[{"9", " ", 
             RowBox[{"a", "^", "2"}]}], "20"], ",", 
           FractionBox[
            RowBox[{"9", " ", 
             RowBox[{"a", "^", "2"}]}], "20"], ",", "0"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"check", "[", 
         RowBox[{"\"\<Derived z values for b = 0 equals paper's\>\"", ",", 
          " ", 
          RowBox[{
           RowBox[{"Sort", "[", 
            RowBox[{"Simplify", "[", "derived", "]"}], "]"}], " ", "==", " ", 
           RowBox[{"Sort", "[", 
            RowBox[{"Simplify", "[", "expected", "]"}], "]"}]}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9926841356030693`*^9, 3.9926841820687447`*^9}, {
