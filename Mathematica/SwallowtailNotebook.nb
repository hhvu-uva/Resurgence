Cell[CellGroupData[{

Cell["Section 3.4 \[LongDash] Determination of the Stokes constants", \
"Section",
 CellChangeTimes->{
  3.993738195580599*^9},ExpressionUUID->"907473ef-2a6c-4c42-81bd-\
794687a0109d"],

Cell[TextData[{
 "The Stokes constants are obtained from the steepest-descent geometry of the \
integral at a fixed point of the \|01d467-plane. The paths of steepest \
descent emerge from each saddle along the directions in which ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Re", " ", "f"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "24735732-c18e-4e43-b0fd-b76e511d9cd4"],
 "decreases."
}], "Text",
 CellChangeTimes->{{3.993738202573578*^9, 3.9937382487901993`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"d8d64886-ef86-1f4a-a325-a52e96770691"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zFixed", "=", 
    RowBox[{"3", "+", 
     RowBox[{"0.5", " ", "I"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"NB", ":", " ", 
     RowBox[{"paper", " ", "mentions", " ", 
      RowBox[{"(", 
       RowBox[{"a", ",", "b"}], ")"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", ",", "3"}], ")"}], " ", "but", " ", "used", " ", 
      RowBox[{"(", 
       RowBox[{"a", ",", "b"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", ",", "1"}], ")"}], " ", "in", " ", "actual", " ", 
      "analysis"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aVal", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bVal", "=", "1"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fT", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"t", "^", "5"}], "-", 
    RowBox[{"aVal", " ", 
     RowBox[{"t", "^", "3"}]}], "-", 
    RowBox[{"I", " ", "bVal", " ", 
     RowBox[{"t", "^", "2"}]}], "+", 
    RowBox[{"zFixed", " ", "t"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fTp", "[", "t_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"fT", "[", "u", "]"}], ",", "u"}], "]"}], "/.", " ", 
     RowBox[{"u", "->", "t"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fTpp", "[", "t_", "]"}], ":=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"fT", "[", "u", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "2"}], "}"}]}], "]"}], "/.", " ", 
      RowBox[{"u", "->", "t"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{"\"\<fT[t] is equal to f[t,zFixed]\>\"", ",", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"fT", "[", "t", "]"}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"t", ",", "zFixed"}], "]"}], "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a", "->", "aVal"}], ",", 
           RowBox[{"b", "->", "bVal"}]}], "}"}]}], ")"}]}], "]"}], "==", 
     "0"}]}], "]"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"saddles", "=", 
   RowBox[{"t", "/.", " ", 
    RowBox[{"NSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fTp", "[", "t", "]"}], "==", "0"}], ",", "t"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fSaddle", "[", "k_", "]"}], ":=", 
   RowBox[{"fT", "[", 
    RowBox[{"saddles", "[", 
     RowBox[{"[", "k", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chiOf", "[", "k_", "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"fSaddle", "[", "k", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"derived", ",", "expected"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"derived", "=", 
     RowBox[{"chiOf", "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "saddles", "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"expected", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1.0464"}], "+", 
        RowBox[{"0.7948", " ", "I"}]}], ",", 
       RowBox[{
        RowBox[{"-", "1.1944"}], "+", 
        RowBox[{"0.0920", " ", "I"}]}], ",", 
       RowBox[{"1.2212", "+", 
        RowBox[{"2.0196", " ", "I"}]}], ",", 
       RowBox[{"1.0196", "+", 
        RowBox[{"0.6936", " ", "I"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<Singulants chi_i at z = 3 + 0.5 I and (a,b)=(3,1) equal \
paper's (3.19)\>\"", ",", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Round", "[", 
         RowBox[{"derived", ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "4"}]}]}], "]"}], "]"}], "==", 
       RowBox[{"Sort", "[", 
        RowBox[{"Round", "[", 
         RowBox[{"expected", ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "4"}]}]}], "]"}], "]"}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.993647198625948*^9, 3.9936472142482224`*^9}, {
   3.993647517484297*^9, 3.993647534730732*^9}, {3.9937349632389145`*^9, 
