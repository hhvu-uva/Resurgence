     RowBox[{"Turning", " ", "points", " ", "from", " ", 
      RowBox[{"(", "3.12", ")"}]}], ",", 
     RowBox[{"for", " ", 
      RowBox[{"markers", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"turningPts", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ss", "=", 
         RowBox[{"t", "/.", " ", 
          RowBox[{"NSolve", "[", 
