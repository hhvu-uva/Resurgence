Cell[TextData[{
 "Substituting the rescalings into (3.2) gives the rescaled ODE. The chain \
rule contributes a factor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\|01d716", 
    RowBox[{"4", 
     RowBox[{"k", "/", "5"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1cc74c03-9275-e349-9c53-0d7300c5cfe3"],
 " to each derivative of order \|01d458."
}], "Text",
