   3.9946756783055096`*^9, 3.994675731454033*^9}, 3.994678891239912*^9, 
   3.9948517911725616`*^9, 3.9948522151677685`*^9, 3.9950145953201447`*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"d22daf10-bab8-1146-b0fe-28a12dc4f82b"]
}, Open  ]],

Cell[TextData[{
 "the special steepest-descent curves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "j"], "(", 
    SubscriptBox["\[Sigma]", "ij"], ")"}], TraditionalForm]],ExpressionUUID->
  "59f867f1-f51d-2048-a6c5-d10d9bd36b28"],
 " are obtained by continuing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"arg", " ", "\[Epsilon]"}], TraditionalForm]],ExpressionUUID->
  "f21d95ee-3778-254a-b68e-40a82559a822"],
 " from ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "ea9f32d8-27c3-ad4d-9164-76db19ab4abd"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "ij"], "=", " ", 
    RowBox[{"arg", "[", 
     RowBox[{
      SubscriptBox["\[Chi]", 
       RowBox[{"j", " "}]], "-", " ", 
      SubscriptBox["\[Chi]", "i"]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"47eb08fe-6a15-584b-b2a3-480a089783b1"],
 ". Panel ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "a06d42a0-7aa6-2443-8bbb-e594df22533b"],
 " shows these three curves  together with the positively oriented contour \
about saddle ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "22385b67-42ba-3a46-b91d-513467931403"],
 ", which is deformed onto them to give the Stokes constants."
}], "Text",
 CellChangeTimes->{{3.9937385041906776`*^9, 3.9937386730071526`*^9}, {
  3.9946759738666267`*^9, 3.994675975309141*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"9e962272-c83a-3e42-ace9-c9713804fded"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sigmaArg", "[", 
     RowBox[{
      RowBox[{"i_", "?", "NumericQ"}], ",", 
      RowBox[{"j_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Arg", "[", 
     RowBox[{
      RowBox[{"chiOf", "[", 
       RowBox[{"Round", "[", "j", "]"}], "]"}], "-", 
      RowBox[{"chiOf", "[", 
       RowBox[{"Round", "[", "i", "]"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"descentDirectionsRot", "[", 
     RowBox[{"j_", ",", "theta_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"phi", "=", 
        RowBox[{"Arg", "[", 
         RowBox[{"fTpp", "[", 
          RowBox[{"saddles", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Pi", "-", "phi", "+", "theta"}], ")"}], "/", "2"}]}], 
         "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Pi", "-", "phi", "+", "theta"}], ")"}], "/", "2"}], "+",
             "Pi"}], ")"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"descentRayRot", "[", 
     RowBox[{"j_", ",", "dir_", ",", "theta_", ",", 
      RowBox[{"sMax_", ":", "8"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ti", "=", 
         RowBox[{"saddles", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ",", 
        RowBox[{"eps", "=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "2"}]}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"t", "'"}], "[", "s", "]"}], "==", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Conjugate", "[", 
               RowBox[{
                RowBox[{"fTp", "[", 
                 RowBox[{"t", "[", "s", "]"}], "]"}], " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "I"}], " ", "theta"}], "]"}]}], "]"}]}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"fTp", "[", 
                 RowBox[{"t", "[", "s", "]"}], "]"}], "]"}], "+", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{"t", "[", "0", "]"}], "==", 
            RowBox[{"ti", "+", 
             RowBox[{"eps", " ", "dir"}]}]}], ",", 
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"fTp", "[", 
                RowBox[{"t", "[", "s", "]"}], "]"}], "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"-", "3"}]}]}], ",", "\"\<StopIntegration\>\""}], 
            "]"}]}], "}"}], ",", "t", ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "0", ",", "sMax"}], "}"}], ",", 
         RowBox[{"MaxSteps", "->", 
          RowBox[{"10", "^", "5"}]}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"raysForCj", "[", 
     RowBox[{"j_", ",", "theta_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"descentRayRot", "[", 
       RowBox[{"j", ",", "#", ",", "theta"}], "]"}], "&"}], "/@", 
     RowBox[{"descentDirectionsRot", "[", 
      RowBox[{"j", ",", "theta"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"saddleColor", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.85", ",", "0.15", ",", "0.15"}], "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.15", ",", "0.45", ",", "0.85"}], "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.10", ",", "0.60", ",", "0.25"}], "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.80", ",", "0.50", ",", "0.05"}], "]"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Figure", " ", "2", 
     RowBox[{"(", "b", ")"}]}], "-", 
    RowBox[{"(", "e", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"panelClean", "[", 
     RowBox[{"i0_", ",", "letter_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"Round", "[", "i0", "]"}]}], ",", "js", ",", "curveGraphics",
         ",", "legendColors", ",", "legendLabels", ",", "pI"}], "}"}], ",", 
      RowBox[{
       RowBox[{"js", "=", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"Range", "[", "4", "]"}], ",", "i"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pI", "=", 
        RowBox[{"paperIndex", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"paper", "'"}], "s", " ", "label", " ", "for", " ", "this", " ", 
         RowBox[{"panel", "'"}], "s", " ", "saddle"}], "*)"}], 
       RowBox[{"curveGraphics", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"saddleColor", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"Thickness", "[", "0.005", "]"}], ",", 
            RowBox[{"rayLine", "/@", 
             RowBox[{"raysForCj", "[", 
              RowBox[{"j", ",", 
               RowBox[{"sigmaArg", "[", 
                RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "js"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"legendColors", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"saddleColor", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", "js"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"legend", " ", "labels", " ", "use", " ", "PAPER", " ", 
         RowBox[{"indices", ":", 
          RowBox[{"C_", 
           RowBox[{"{", 
            RowBox[{"paper", 
             RowBox[{"(", "j", ")"}]}], "}"}], 
           RowBox[{"(", 
            RowBox[{"sigma_", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"paper", 
                RowBox[{"(", "i", ")"}]}], ",", 
               RowBox[{"paper", 
                RowBox[{"(", "j", ")"}]}]}], "}"}]}], ")"}]}]}]}], "*)"}], 
       RowBox[{"legendLabels", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<C\>\"", ",", 
                 RowBox[{"paperIndex", "[", 
                  RowBox[{"[", "#", "]"}], "]"}]}], "]"}], ",", "\"\<(\>\"", ",", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<\[Sigma]\>\"", ",", 
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"paperIndex", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"paperIndex", "[", 
                    RowBox[{"[", "#", "]"}], "]"}]}], "}"}], "]"}]}], "]"}], 
               ",", "\"\<)\>\""}], "}"}], "]"}], ",", "10"}], "]"}], "&"}], "/@",
          "js"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Legended", "[", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"curveGraphics", ",", "Black", ",", "Thick", ",", 
             RowBox[{"Circle", "[", 
              RowBox[{
               RowBox[{"ReIm", "[", 
                RowBox[{"saddles", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "0.22"}], "]"}], 
             ",", "Black", ",", 
             RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
             RowBox[{"Point", "[", 
              RowBox[{"ReIm", "/@", "saddles"}], "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{
              "saddle", " ", "NUMBER", " ", "labels", " ", "use", " ", 
               "paper", " ", "indices"}], "*)"}], "Black", ",", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Text", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"paperIndex", "[", 
                    RowBox[{"[", "#2", "]"}], "]"}], ",", "Bold"}], "]"}], ",", 
                  RowBox[{"ReIm", "[", "#1", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "1.5"}], ",", 
                    RowBox[{"-", "1.5"}]}], "}"}]}], "]"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{"saddles", ",", 
                 RowBox[{"Range", "[", "4", "]"}]}], "}"}]}], "]"}]}], "}"}], 
           ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Re[t]\>\"", ",", "\"\<Im[t]\>\""}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              
              RowBox[{"\"\<(\>\"", ",", "letter", ",", "\"\<) saddle \>\"", ",",
                "pI"}], "}"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{"legendColors", ",", "legendLabels", ",", 
             RowBox[{"LegendMarkerSize", "->", "15"}], ",", 
             RowBox[{"LegendMargins", "->", "2"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.9", ",", "0.75"}], "}"}]}], "]"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"panelClean", "[", 
        RowBox[{
         RowBox[{"ourIndex", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "\"\<b\>\""}], "]"}], ",", 
       RowBox[{"panelClean", "[", 
        RowBox[{
         RowBox[{"ourIndex", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", "\"\<c\>\""}], "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"panelClean", "[", 
        RowBox[{
         RowBox[{"ourIndex", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<d\>\""}], "]"}], ",", 
       RowBox[{"panelClean", "[", 
        RowBox[{
         RowBox[{"ourIndex", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<e\>\""}], "]"}]}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "1000"}], ",", 
   RowBox[{"Spacings", "->", "20"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.993791165924284*^9, 3.993791165924284*^9}, {
