Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"The", " ", "automorphism", " ", "T_", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", ">", "k"}], ";", "j"}], "}"}]}], ":", "S_ik"}], "->", 
     RowBox[{"S_ik", "+", 
      RowBox[{"S_ij", " ", "S_jk"}]}]}], ",", 
    RowBox[{
     RowBox[{"with", " ", 
      RowBox[{"antisymmetry", ".", "`sign`"}]}], "=", 
     RowBox[{
      RowBox[{"+", "1"}], " ", "forward", " ", 
      RowBox[{"(", 
       RowBox[{"with", " ", "the", " ", 
        RowBox[{"line", "'"}], "s", " ", "direction"}], ")"}]}]}], ",", 
    RowBox[{
     RowBox[{"-", "1"}], " ", "inverse", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"against", " ", "it"}], ")"}], "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"applyAuto", "[", 
      RowBox[{"S_", ",", 
       RowBox[{"{", 
        RowBox[{"i_", ",", "k_", ",", "j_"}], "}"}], ",", "sign_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Snew", "=", "S"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Snew", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "k"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"S", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k"}], "]"}], "]"}], "+", 
          RowBox[{"sign", " ", 
           RowBox[{"S", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}], " ", 
           RowBox[{"S", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "k"}], "]"}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Snew", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i"}], "]"}], "]"}], "=", 
         RowBox[{"-", 
          RowBox[{"Snew", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k"}], "]"}], "]"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"preserve", " ", "antisymmetry"}], "*)"}], "Snew"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Clockwise", " ", "walk", " ", "c1"}], "->", 
      RowBox[{"c2", "->", 
       RowBox[{"...", "->", 
        RowBox[{
         RowBox[{"c8", ".", "For"}], " ", "each", " ", 
         RowBox[{"step", ":", 
          RowBox[{"the", " ", "triple", " ", 
           RowBox[{"(", 
            RowBox[{"i", ",", "k", ",", "j"}], ")"}], " ", "of", " ", "the", " ",
