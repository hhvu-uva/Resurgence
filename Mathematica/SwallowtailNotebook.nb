Cell[TextData[{
 "the special steepest-descent curves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "j"], "(", 
    SubscriptBox["\[Sigma]", "ij"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "59f867f1-f51d-2048-a6c5-d10d9bd36b28"],
 " are obtained by continuing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"arg", " ", "\[Epsilon]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f21d95ee-3778-254a-b68e-40a82559a822"],
 " from ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea9f32d8-27c3-ad4d-9164-76db19ab4abd"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "ij"], "=", " ", 
    RowBox[{"arg", "[", 
     RowBox[{
      SubscriptBox["\[Chi]", 
       RowBox[{"j", " "}]], "-", " ", 
      SubscriptBox["\[Chi]", "i"]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "47eb08fe-6a15-584b-b2a3-480a089783b1"],
 ". Panel ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a06d42a0-7aa6-2443-8bbb-e594df22533b"],
 " shows these three curves  together with the positively oriented contour \
about saddle ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22385b67-42ba-3a46-b91d-513467931403"],
 ", which is deformed onto them to give the Stokes constants."
}], "Text",
 CellChangeTimes->{{3.9937385041906776`*^9, 3.9937386730071526`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"9e962272-c83a-3e42-ace9-c9713804fded"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sigmaArg", "[", 
     RowBox[{
      RowBox[{"i_", "?", "NumericQ"}], ",", 
      RowBox[{"j_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Arg", "[", 
     RowBox[{
      RowBox[{"chiOf", "[", 
       RowBox[{"Round", "[", "j", "]"}], "]"}], "-", 
      RowBox[{"chiOf", "[", 
       RowBox[{"Round", "[", "i", "]"}], "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"descentDirectionsRot", "[", 
     RowBox[{"j_", ",", "theta_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"phi", "=", 
        RowBox[{"Arg", "[", 
         RowBox[{"fTpp", "[", 
          RowBox[{"saddles", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Pi", "-", "phi", "+", "theta"}], ")"}], "/", "2"}]}], 
         "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Pi", "-", "phi", "+", "theta"}], ")"}], "/", "2"}], "+",
             "Pi"}], ")"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"descentRayRot", "[", 
     RowBox[{"j_", ",", "dir_", ",", "theta_", ",", 
      RowBox[{"sMax_", ":", "8"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ti", "=", 
         RowBox[{"saddles", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ",", 
        RowBox[{"eps", "=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "2"}]}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"t", "'"}], "[", "s", "]"}], "==", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Conjugate", "[", 
               RowBox[{
                RowBox[{"fTp", "[", 
                 RowBox[{"t", "[", "s", "]"}], "]"}], " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "I"}], " ", "theta"}], "]"}]}], "]"}]}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"fTp", "[", 
                 RowBox[{"t", "[", "s", "]"}], "]"}], "]"}], "+", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{"t", "[", "0", "]"}], "==", 
            RowBox[{"ti", "+", 
             RowBox[{"eps", " ", "dir"}]}]}], ",", 
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"fTp", "[", 
                RowBox[{"t", "[", "s", "]"}], "]"}], "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"-", "3"}]}]}], ",", "\"\<StopIntegration\>\""}], 
            "]"}]}], "}"}], ",", "t", ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "0", ",", "sMax"}], "}"}], ",", 
         RowBox[{"MaxSteps", "->", 
