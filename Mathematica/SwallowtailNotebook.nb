Cell[CellGroupData[{
Cell["3 Asymptotic analysis of the swallowtail catastrophe", "Chapter",
 CellChangeTimes->{{3.993290797359913*^9, 3.993290798362421*^9}, 
   3.993290830811924*^9},ExpressionUUID->"7bb090e4-2d3a-7540-8501-\
201426ca61d7"],

Cell[TextData[{
 "This intent of this notebook is to model the analysis done in section 3 of \
the paper ",
 StyleBox["Automorphisms of Stokes multipliers in higher-order WKBJ theory ",
  FontSlant->"Italic"],
 "by Shelton ",
 StyleBox["et al.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.993290834185541*^9, 3.9932909619474316`*^9}, {
  3.9937909241068535`*^9, 
  3.993790925953951*^9}},ExpressionUUID->"934526da-a00a-4440-be46-\
d3f441b29e1b"],

