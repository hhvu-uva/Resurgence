Cell[CellGroupData[{

Cell["Section 3.2.1 \[LongDash] Singular points", "Subsection",
 CellChangeTimes->{
  3.99373727084132*^9},ExpressionUUID->"703c3697-4ec8-ac4d-b379-a0ac371782a7"],

Cell[TextData[{
 "The leading amplitude is singular where its denominator vanishes. Solving \
that cubic for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ea41515-4802-7c4b-b787-2de38368c9cb"],
 " and mapping through the singulant equation locates the three singular \
points in the \nz-plane; reduction modulo the cubic gives the compact form \
(3.12)."
}], "Text",
 CellChangeTimes->{{3.9937373106227474`*^9, 3.9937373664816895`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"51214aab-7449-2843-b5bf-f6a2f72cc3ae"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"singularCubic", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "10"}], " ", 
      RowBox[{"t", "^", "3"}]}], "+", 
     RowBox[{"3", " ", "a", " ", "t"}], "-", 
     RowBox[{"I", " ", "b"}]}], "==", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tRoots", "=", 
    RowBox[{"t", "/.", " ", 
     RowBox[{"Solve", "[", 
      RowBox[{"singularCubic", ",", "t"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zExpr", "=", 
   RowBox[{"z", "/.", " ", 
    RowBox[{"First", "[", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"singulantEqn", "/.", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"chi", "'"}], "[", "z", "]"}], "->", "tt"}]}], ",", "z"}], 
      "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zFromSingulant", "[", "t_", "]"}], ":=", 
   RowBox[{"zExpr", "/.", " ", 
    RowBox[{"tt", "->", "t"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zOfT", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"PolynomialReduce", "[", 
      RowBox[{
       RowBox[{"zFromSingulant", "[", "t", "]"}], ",", 
       RowBox[{"First", "[", "singularCubic", "]"}], ",", "t"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zOfTFunctionDerived", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Evaluate", "[", "zOfT", "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equation", " ", 
    RowBox[{"(", "3.12", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zOfTFunction", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"3", "t"}], "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", " ", "t"}], " ", "-", " ", 
      RowBox[{"I", " ", "b"}]}], ")"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"check", "[", 
  RowBox[{"\"\<zOfTFunctionDerived equals (3.12)\>\"", ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"zOfTFunctionDerived", "[", "t", "]"}], " ", "==", " ", 
     RowBox[{"zOfTFunction", "[", "t", "]"}]}], " ", "//", "Simplify"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9926129180542965`*^9, 3.992612923220537*^9}, {
   3.992613146652458*^9, 3.9926132263144245`*^9}, {3.9926132950444374`*^9, 
