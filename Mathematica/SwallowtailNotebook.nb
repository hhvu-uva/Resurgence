       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"raysForCj", "[", 
     RowBox[{"j_", ",", "theta_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"descentRayRot", "[", 
       RowBox[{"j", ",", "#", ",", "theta"}], "]"}], "&"}], "/@", 
     RowBox[{"descentDirectionsRot", "[", 
      RowBox[{"j", ",", "theta"}], "]"}]}]}], ";"}], "\n"}], 
"\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"saddleColor", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.85", ",", "0.15", ",", "0.15"}], "]"}], ",", 
