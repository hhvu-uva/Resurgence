}, Open  ]],

Cell["\<\
The remaining orders give the amplitude equation. Expanding the amplitude in \
powers of \[Epsilon] and taking the leading balance yields the transport \
equation, whose solution is the leading-order amplitude.\
\>", "Text",
 CellChangeTimes->{{3.993737164891754*^9, 3.9937371683466244`*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"4cc0805f-f28d-5843-85c0-b9b45e4b2a8c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Equation", " ", 
    RowBox[{"(", "3.8", ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nextToLeadingOrder", " ", "=", " ", 
     RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "rescaledSwallowtailODESingleComponent", " ", "-", " ", 
         "leadingOrder"}], ")"}], "/", "eps"}], " ", "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Equation", " ", 
     RowBox[{"(", "3.9", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nmax", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ampExpansionRule", "=", 
     RowBox[{"amp", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"zz", ",", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"eps", "^", "n"}], " ", 
           RowBox[{
            RowBox[{"ampn", "[", "n", "]"}], "[", "zz", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"transportEqnDerived", "=", 
     RowBox[{
      RowBox[{"Coefficient", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nextToLeadingOrder", " ", "/.", " ", "ampExpansionRule"}], 
        "\[IndentingNewLine]", ",", "eps", ",", "0"}], "]"}], "==", "0"}]}], 
    " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Equation", " ", 
      RowBox[{"(", "3.10", ")"}]}], ";", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ampn", "[", "0", "]"}], "[", "z", "]"}], " ", "=", " ", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["\[Psi]", "0"], "n"], 
       RowBox[{"(", "z", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"transportEqn", " ", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "20"}], 
           RowBox[{
            RowBox[{
             RowBox[{"chi", "'"}], "[", "z", "]"}], "^", "3"}]}], " ", "+", 
          " ", 
          RowBox[{"6", "a", " ", 
           RowBox[{
            RowBox[{"chi", "'"}], "[", "z", "]"}]}], "-", 
          RowBox[{"2", " ", "I", " ", "b"}]}], ")"}], 
        RowBox[{
         RowBox[{
          RowBox[{"ampn", "[", "0", "]"}], "'"}], "[", "z", "]"}]}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", "a", " ", 
           RowBox[{
            RowBox[{"chi", "''"}], "[", "z", "]"}]}], "-", " ", 
          RowBox[{"30", " ", 
           RowBox[{
            RowBox[{"chi", "''"}], "[", "z", "]"}], 
           RowBox[{
            RowBox[{
             RowBox[{"chi", "'"}], "[", "z", "]"}], "^", "2"}]}]}], ")"}], 
        RowBox[{
         RowBox[{"ampn", "[", "0", "]"}], "[", "z", "]"}]}]}], " ", "==", 
      "0"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"check", "[", 
    RowBox[{"\"\<transportEqnDerived equals paper's (3.10)\>\"", ",", " ", 
     RowBox[{
      RowBox[{"transportEqnDerived", "==", "transportEqn"}], "//", 
      "Expand"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.992607931258566*^9, 3.992607941944233*^9}, {
   3.9926079801679554`*^9, 3.9926080097385826`*^9}, {3.992608110323557*^9, 
   3.992608112128134*^9}, {3.992609494689268*^9, 3.9926095203766327`*^9}, {
   3.9926097781787434`*^9, 3.9926098122263985`*^9}, {3.9926098632438984`*^9, 
   3.9926098746728306`*^9}, {3.992609916912634*^9, 3.992609951378086*^9}, {
   3.992609985247284*^9, 3.9926100123756886`*^9}, {3.9926100953965225`*^9, 
   3.9926100997104244`*^9}, {3.9937371817383785`*^9, 
   3.9937372524359818`*^9}, {3.993791631115055*^9, 3.9937916415837593`*^9}, 
   3.994391185410568*^9, {3.994391221621681*^9, 3.9943913362779846`*^9}, {
   3.994391367053282*^9, 3.9943913680814743`*^9}, {3.9943914556940327`*^9, 
   3.9943915302092743`*^9}, {3.9943916351019707`*^9, 3.994391688845337*^9}, {
   3.994391736547407*^9, 3.9943917660468063`*^9}, 3.9943919335315914`*^9, {
   3.9943943716854973`*^9, 3.9943943806031647`*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"bfb02dbf-ace4-3744-8a38-3bc0b5106f79"],

